<Project Sdk="Skyline.DataMiner.Sdk">
	<PropertyGroup>
		<TargetFramework>net48</TargetFramework>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
	</PropertyGroup>

	<PropertyGroup>
		<DataMinerType>TestPackage</DataMinerType>
		<GenerateDataMinerPackage>True</GenerateDataMinerPackage>
		<MinimumRequiredDmVersion>10.6.8</MinimumRequiredDmVersion>
		<Version>1.0.0</Version>
		<VersionComment>Service Management regression tests</VersionComment>
		<!-- Do NOT fill in the Organization Token here. This points to either an Environment Variable skyline__sdk__dataminertoken holding the organization token or a Visual Studio User Secret holding the token. -->
		<!--<CatalogPublishKeyName>skyline:sdk:dataminertoken</CatalogPublishKeyName>-->
		<CatalogDefaultDownloadKeyName>skyline:sdk:dataminertoken</CatalogDefaultDownloadKeyName>
		<!-- Shares the user secrets (Catalog organization key) of the SLC-Service-Management package project. --><!--
		<UserSecretsId>c77184c7-44bc-4fa1-bbac-614d79915f0e</UserSecretsId>-->
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Skyline.DataMiner.Core.AppPackageInstaller" Version="4.4.0" />
		<PackageReference Include="Skyline.DataMiner.Dev.Automation" Version="10.4.0.24" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Skyline.DataMiner.CICD.CSharpAnalysis.Analyzer" Version="2.2.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Skyline.DataMiner.Utils.SecureCoding.Analyzers" Version="3.0.1">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<Compile Remove="TestPackageContent\Dependencies\**" />
		<Compile Remove="TestPackageContent\TestHarvesting\**" />
		<Compile Remove="TestPackageContent\Tests\**" />
	</ItemGroup>

	<!-- Build order only: the integration tests are harvested from postbuild.generated by that project. -->
	<ItemGroup>
		<ProjectReference Include="..\Tests\SLC_SM_RT.QAOps.IntegrationTests\SLC_SM_RT.QAOps.IntegrationTests.csproj" ReferenceOutputAssembly="false" />
	</ItemGroup>

	<!-- A ProjectReference to a Package project is reinterpreted by the SDK as a script reference, so the solution
	     package is built with an MSBuild task; its own CopyDmappToQaOpsTestPackage target bundles the .dmapp here. -->
	<Target Name="EnsureSolutionPackageBundled" BeforeTargets="DmappCreation">
		<MSBuild Projects="$(MSBuildThisFileDirectory)..\SLC-Service-Management\SLC-Service-Management.csproj" Targets="Build" Properties="Configuration=$(Configuration)" />
		<ItemGroup>
			<_BundledSolutionDmapp Include="$(MSBuildThisFileDirectory)TestPackageContent\Dependencies\SLC-Service-Management.*.dmapp" />
		</ItemGroup>
		<Error Condition="'@(_BundledSolutionDmapp)' == ''" Text="SLC-Service-Management .dmapp was not copied into TestPackageContent\Dependencies. Build SLC-Service-Management first." />
	</Target>

	<ItemGroup>
		<Content Include="TestPackageContent\Dependencies\**">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="TestPackageContent\TestHarvesting\**">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="TestPackageContent\Tests\**">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>
</Project>