<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x86</PlatformTarget>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="MSTest" Version="3.6.4" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Skyline.DataMiner.Dev.Automation" Version="10.6.10.1" />
  </ItemGroup>

  <!-- The package project is not referenced: building it also builds the web app. Its DOM installer sources are linked instead. -->
  <ItemGroup>
    <Compile Include="..\SLC-Service-Management\SolutionInstallerHelper\Dom\*.cs" Link="Linked\Dom\%(Filename)%(Extension)" />
    <None Include="..\SLC-Service-Management\SetupContent\DomModules\**\*.json" Link="DomModules\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

</Project>
