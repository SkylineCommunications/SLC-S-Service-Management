<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <RootNamespace>SLC_Service_Management.IntegrationTests</RootNamespace>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" Version="1.64.1" />
    <PackageReference Include="MSTest" Version="4.0.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Skyline.DataMiner.CICD.Tools.WinEncryptedKeys.Lib" Version="2.2.0" />
    <PackageReference Include="Skyline.DataMiner.Core.DataMinerSystem.Common" Version="1.2.1.3" />
    <PackageReference Include="Skyline.DataMiner.Files.SLNetTypes" Version="10.6.11" />
  </ItemGroup>

  <!-- Harvest the built test output into the QAOps Test Package; its TestDiscovery.ps1 packages this folder. -->
  <Target Name="CopyIntegrationTestOutputToTestPackage" AfterTargets="Build">
    <ItemGroup>
      <IntegrationTestOutput Include="$(OutputPath)**\*.*" Exclude="$(OutputPath)TestResults\**" />
    </ItemGroup>
    <Copy
      SourceFiles="@(IntegrationTestOutput)"
      DestinationFiles="@(IntegrationTestOutput->'$(MSBuildThisFileDirectory)..\SLC-Service-Management.QAOps\TestPackageContent\TestHarvesting\postbuild.generated\$(MSBuildProjectName)\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>

</Project>
